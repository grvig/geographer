{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grvig/geographer/blob/main/content/schema/categories.schema.json",
  "title": "Categories",
  "description": "The clue categories in content/categories.yaml.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "label", "detector", "negatives", "overlay_colour", "scene"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "label": { "type": "string", "minLength": 1 },
      "detector": {
        "description": "Where detections come from: Mapillary classes, OWLv2 prompts, or both.",
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "mapillary": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+(--[a-z0-9-]+)+$"
            }
          },
          "owl": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompts", "threshold"],
            "properties": {
              "prompts": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "threshold": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            }
          }
        }
      },
      "negatives": {
        "description": "Things often mistaken for this category, described by look. They give the matcher a 'none of these' answer.",
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 3 }
      },
      "overlay_colour": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
      "scene": { "type": "boolean" }
    }
  }
}
