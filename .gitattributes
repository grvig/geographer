# Normalise line endings to LF in the repository, whatever the OS
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.gif binary
*.ico binary
*.pt binary
*.sqlite binary

# Keep generated data out of diffs and language stats
web/public/data/** linguist-generated=true -diff
**/package-lock.json linguist-generated=true -diff
